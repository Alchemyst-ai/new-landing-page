STRAPI_API_TOKEN=YOUR_STRAPI_API_TOKEN
STRAPI_API_URL=YOUR_STRAPI_API_URL
PAGESPEED_API_KEY=YOUR_PAGESPEED_API_KEY
ALCHEMYSTAI_API_KEY=YOUR_ALCHEMYSTAI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=YOUR_OPENROUTER_MODEL
OPENROUTER_MODEL_PROVIDER=YOUR_OPENROUTER_MODEL_PROVIDER
# Assessment generation. Comma separated models tried after OPENROUTER_MODEL
# fails or times out. Avoid router models like openrouter/free in production.
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite
# Optional overrides (ms). Defaults: 45000 per attempt, 110000 total.
# ASSESSMENT_ATTEMPT_TIMEOUT_MS=45000
# ASSESSMENT_TOTAL_TIMEOUT_MS=110000
TALLY_API_KEY=YOUR_TALLY_API_KEY
TURSO_DATABASE_URL=YOUR_TURSO_DATABASE_URL
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=YOUR_RESEND_FROM_ADDRESS